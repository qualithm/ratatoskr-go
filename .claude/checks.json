{
  "version": 1,
  "commands": [
    {
      "run": "test -z \"$(gofmt -s -l . | tee /dev/stderr)\"",
      "timeout": "10m",
      "dir": "."
    },
    {
      "run": "go mod tidy -diff",
      "timeout": "10m",
      "dir": "."
    },
    {
      "run": "go vet ./...",
      "timeout": "10m",
      "dir": "."
    },
    {
      "run": "go build ./...",
      "timeout": "10m",
      "dir": "."
    },
    {
      "run": "golangci-lint run",
      "timeout": "10m",
      "dir": "."
    },
    {
      "run": "python3 .claude/checks/ci-jobs.py --skip-ci-only coverage",
      "timeout": "30m",
      "dir": "."
    }
  ]
}
